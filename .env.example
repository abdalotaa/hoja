# Copia a .env.local para desarrollo; en Vercel agrégalas en Settings → Environment Variables.

# IA (resúmenes)
OPENAI_API_KEY=
# Opcional: modelo barato para los resúmenes (por defecto gpt-4o-mini)
OPENAI_MODEL=

# Cuentas y notas en la nube (Supabase → Project Settings → API).
# Si las dejas vacías, Hoja funciona en modo local: sin login y notas solo en este navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
